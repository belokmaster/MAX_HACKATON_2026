# Токен бота платформы MAX
BOT_TOKEN=your_bot_token_here

# Секретный ключ подписи вебхука (валидируется по заголовку X-Max-Bot-Api-Secret, 5-256 символов)
WEBHOOK_SECRET=your_webhook_secret_here

# Публичный HTTPS URL для приема вебхуков (порт 443, без указания порта в URL)
WEBHOOK_URL=https://your-domain.com/webhook

# Список ID администраторов бота через запятую
ADMIN_USER_IDS=12345678,87654321

# Public domain for Caddy/HTTPS
DOMAIN=localhost

